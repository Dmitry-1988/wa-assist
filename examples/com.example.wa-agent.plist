<?xml version="1.0" encoding="UTF-8"?>
<!--
  One unattended cycle every 300 seconds.

  Before installing, change:
    * the Label, if you want your own (set WA_DAEMON_LABEL to match)
    * WorkingDirectory      -> where you cloned this
    * the first argument    -> output of `which uv`
    * StandardOut/ErrorPath -> inside that same directory

  launchd caches this file at bootstrap, so after editing it:
    launchctl bootout   gui/$(id -u)/com.example.wa-agent
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.wa-agent.plist

  It must run in the Aqua GUI session: it drives a real Chromium window
  (minimised via CDP, not headless; WhatsApp Web does not render headless).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.wa-agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--directory</string>
    <string>/Users/CHANGE-ME/wa-assist</string>
    <string>wa-agent</string>
    <string>tick</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/CHANGE-ME/wa-assist</string>

  <!-- How often to look for new messages. This is the dominant term in
       "message arrives" to "draft appears": you wait half of it on average.
       An idle tick costs ~20s, so 120 spends about a fifth of the time with a
       browser open; 300 is calmer, 60 is most of the time. -->
  <key>StartInterval</key>
  <integer>120</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/CHANGE-ME/wa-assist/.wa-agent/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGE-ME/wa-assist/.wa-agent/daemon.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd gives a service a minimal PATH; binaries are resolved in
         code, but uv itself must be findable here. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>WA_DAEMON_LABEL</key>
    <string>com.example.wa-agent</string>
  </dict>
</dict>
</plist>
